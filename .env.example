# Copy to .env for local use. These values are DEMO-only and must be replaced before deployment.
MODE=DEMO
DEMO_DB_PASSWORD=quoteflow_local_only
QUOTEFLOW_PORT=8080
WORKER_POLL_SECONDS=10
# PUBLIC_BASE_URL and API_BASE_URL derive from QUOTEFLOW_PORT by default.
# Set them explicitly only when using a different public hostname or proxy.
SESSION_SECURE=false
APPROVAL_DISCOUNT_THRESHOLD=10.00
DEFAULT_TAX_PERCENT=0.00
DEFAULT_CONTINGENCY_PERCENT=0.00
PORTAL_TTL_DAYS=14
OPENAI_MODEL=
OPENAI_API_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quoteflow
